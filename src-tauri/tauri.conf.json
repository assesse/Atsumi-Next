{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atsumi Next",
  "version": "0.1.0",
  "identifier": "local.atsumi.next",
  "build": {
    "beforeDevCommand": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/run_frontend.ps1 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/run_frontend.ps1 build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "tooltip": "Atsumi Next",
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Atsumi Next",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
